# Copy this file to `.env` and fill in your own values.
# Never commit `.env` — it is listed in .gitignore.

# Firebase (Project settings → Your apps → Web app config)
VITE_FIREBASE_KEY=""
VITE_FIRE_BASE_AUTH_DOMAIN=""
VITE_PROJECT_ID=""
VITE_STORAGE_BUCKET=""
VITE_MESSASGING_SENDER_ID=""
VITE_APP_ID=""
VITE_MEASUREMENT_ID=""

# Cloudinary (image hosting)
# VITE_CLOUDINARY_URL looks like https://api.cloudinary.com/v1_1/<cloud_name>/image/upload
# VITE_UPLOAD_PRESET must be an *unsigned* upload preset
VITE_CLOUDINARY_URL=""
VITE_UPLOAD_PRESET=""

# TinyMCE rich-text editor API key (https://www.tiny.cloud)
VITE_Editor_API=""
